# 测试环境 test
# 定义应用运行环境为测试环境(test)
TARO_APP_ENV=test
# 定义应用ID，当前为空值待配置
TARO_APP_ID=
# 定义站点名称为tuyou-test（途游测试环境）
TARO_APP_SITE_NAME=tuyou-test
# 定义API接口基础地址为本地开发服务器
TARO_APP_API_BASE=http://192.168.10.7:84/api/v1
# 定义静态资源基础地址，当前为空使用相对路径
TARO_APP_ASSET_BASE=
# 关闭Mock数据模拟功能
TARO_APP_ENABLE_MOCK=false
# 设置日志输出级别为info级别
TARO_APP_LOG_LEVEL=info

