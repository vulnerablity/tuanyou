#+ 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会入库
APP_ENV=dev
SECRET_KEY=dev-secret-change-me

# MySQL 连接串（SQLAlchemy 2.0 async，接入数据库时启用）
DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/tuyou

# Redis（验证码/限流/未读数）
REDIS_URL=redis://127.0.0.1:6379/0

# 跨域来源，逗号分隔；留空 = 允许所有来源（仅限开发环境）
CORS_ORIGINS=
